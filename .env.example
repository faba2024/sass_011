# ====================================================================
# TOP BURGER OS — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# ====================================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Somente servidor (criar usuários de funcionários e empresas no painel master).
# Nunca exponha no navegador e nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública do app (usada em links de WhatsApp, QR Codes e e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domínio raiz para subdomínios das lojas (ex.: leviburguer.topburger.app)
# Em desenvolvimento deixe vazio e acesse http://localhost:3000/leviburguer
NEXT_PUBLIC_ROOT_DOMAIN=
